# ============================================
# SHIFTBASE - Environment Configuration Template
# Copy to .env and fill in your values
# NEVER commit real credentials to Git
# ============================================

# AI Provider: "gemini" or "ollama"
AI_PROVIDER=gemini

# Google Gemini API Key (get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Ollama Settings (if using local AI instead of Gemini)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Path
DATABASE_PATH=../data/shiftbase.db

# Security (generate a random 32+ character string)
SECRET_KEY=

# Debug Mode (set to false in production)
DEBUG=trues